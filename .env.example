# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GHL Webhook URLs for form submissions
# Legacy (client-side): kept for backward compat while VITE_USE_LEAD_API is unset/"false".
VITE_GHL_QUOTE_WEBHOOK="https://services.leadconnectorhq.com/hooks/a9j6O8eXLyQk7lKBkZFD/webhook-trigger/YOUR_QUOTE_WEBHOOK_ID"
VITE_GHL_CONTACT_WEBHOOK="https://services.leadconnectorhq.com/hooks/a9j6O8eXLyQk7lKBkZFD/webhook-trigger/YOUR_CONTACT_WEBHOOK_ID"

# Feature flag — when "true", forms POST to /api/lead (server-side fan-out with Meta CAPI).
# When unset or "false", forms keep posting straight to the GHL webhook as before.
VITE_USE_LEAD_API="false"

# Server-side env (Vercel Project Settings → Environment Variables).
# NOT prefixed with VITE_ so they never leak to the browser bundle.
GHL_QUOTE_WEBHOOK="https://services.leadconnectorhq.com/hooks/a9j6O8eXLyQk7lKBkZFD/webhook-trigger/YOUR_QUOTE_WEBHOOK_ID"

# Meta Conversions API (server-side events, dedup against Pixel via shared event_id).
# Generate token: Business Manager → Events Manager → Pixel → Settings → Conversions API → Generate Access Token.
META_PIXEL_ID="1221912536436874"
META_CAPI_TOKEN=""
# Optional: paste a test event code from Events Manager → Test Events to verify before going live.
META_TEST_EVENT_CODE=""
